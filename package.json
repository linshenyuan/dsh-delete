{
  "name": "dsh-delete",
  "version": "0.2.0",
  "description": "给 DSH（DeepSeek Harness）会话列表加「删除对话」与「批量删除…」菜单项，快捷键 Ctrl+Alt+D / Ctrl+Alt+Shift+D，带二次确认，真正从磁盘删除。",
  "license": "MIT",
  "author": "Aland",
  "type": "module",
  "icon": "./icon.svg",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "bundle",
    "session",
    "delete",
    "batch"
  ],
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "src",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-shortcuts"
      ]
    }
  }
}
